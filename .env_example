# ── TestMu AI Browser Cloud credentials ──────────────────────────────────────
# Get these from: https://www.testmuai.com/settings/billing
LT_USERNAME=<Your_LT_Username>
LT_ACCESS_KEY=<Your_LT_Password>

# X / Twitter credentials: Session cookie is recommended over manually passsing credentials
X_USERNAME=<Your_X_Username>         # without the @
X_PASSWORD=<Your_X_Password>
X_EMAIL=example@gmail.com            # needed for X's login challenge

# ── Post content ──────────────────────────────────────────────────────────────
POST_TEXT="Just shipped something with TestMu AI Browser Cloud + Puppeteer 🚀\n\n#automation #ai #devtools"
# Absolute or relative path to the image you want to attach
POST_IMAGE_PATH=./assets/post-image.png